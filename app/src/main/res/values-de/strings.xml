    <string name="settings_date_order">Mehrdeutige Datumsangaben</string>
    <string name="settings_date_order_hint">Ein Datum wie 03/04 kann der 4. März oder der 3. April sein. Das legt fest, wovon ausgegangen wird, wenn der Beleg keinen weiteren Hinweis gibt.</string>
